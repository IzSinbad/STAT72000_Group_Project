    "\n",
    "# Add legend\n",
    "plt.legend(loc='upper right', bbox_to_anchor=(0.1, 0.1))\n",
    "plt.title('Top 5 Artists with Strongest Cross-Platform Presence', size=15, y=1.1)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Display the top 10 artists with strongest cross-platform presence\n",
    "print(\"Top 10 Artists with Strongest Cross-Platform Presence:\")\n",
    "print(top_cross_platform_artists.head(10))"
   ]
